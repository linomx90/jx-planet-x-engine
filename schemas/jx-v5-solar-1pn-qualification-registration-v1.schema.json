{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-qualification-registration-v1.schema.json",
  "title": "JX V5 Solar 1PN qualification pre-execution registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "plan_identity_sha256",
    "state",
    "registered_utc",
    "foundation_commit",
    "outcomes_generated",
    "plan",
    "inputs",
    "prior_development_manifest",
    "schemas",
    "known_prior_evidence",
    "execution_implementation_state",
    "registry_authorized",
    "output_evidence_class",
    "blocking_status",
    "permitted_claim_code",
    "permitted_claim_text",
    "prohibited_claim_codes",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-qualification-registration-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-qualification-registration/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "plan_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "state": {
      "const": "REGISTERED_BEFORE_HOLDOUT_OUTCOMES"
    },
    "registered_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "foundation_commit": {
      "const": "58b57094d519205f3ef398f3c738af96107c59e5"
    },
    "outcomes_generated": {
      "const": false
    },
    "plan": {
      "$ref": "#/$defs/documentBinding"
    },
    "inputs": {
      "$ref": "#/$defs/documentBinding"
    },
    "prior_development_manifest": {
      "$ref": "#/$defs/priorDevelopmentManifestBinding"
    },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/schemaBinding"
      }
    },
    "known_prior_evidence": {
      "$ref": "#/$defs/knownPriorEvidence"
    },
    "execution_implementation_state": {
      "const": "NOT_REGISTERED"
    },
    "registry_authorized": {
      "const": false
    },
    "output_evidence_class": {
      "const": "MODEL_OUTPUT"
    },
    "blocking_status": {
      "$ref": "#/$defs/blockingStatus"
    },
    "permitted_claim_code": {
      "const": "FROZEN_RESTRICTED_SOLAR_1PN_REFERENCE_REPRODUCTION_ELIGIBLE_FOR_EXTERNAL_REVIEW_NONAUTHORIZING"
    },
    "permitted_claim_text": {
      "const": "For the frozen cases and declared domain in qualification package <qualification_id>, the nonauthorizing JX reference path reproduced the declared restricted static-Sun, massless-target Schwarzschild 1PN equation within the preregistered numerical and model-matched error budgets. The resulting trajectories are MODEL_OUTPUT and are eligible only for external scientific review."
    },
    "prohibited_claim_codes": {
      "type": "array",
      "const": [
        "NO_REGISTRY_AUTHORITY",
        "NO_PRODUCTION_INTEGRATOR",
        "NO_OBSERVATIONAL_EPHEMERIS",
        "NO_FULL_EIH_IMPLEMENTATION",
        "NO_DE440_HORIZONS_REPRODUCTION",
        "NO_DETECTION_EXCLUSION_CONSTRAINT",
        "NO_PHYSICAL_COMPLETENESS",
        "NO_SYMPLECTICITY_OR_EXACT_REVERSIBILITY",
        "NO_PERFORMANCE_SUPERIORITY"
      ]
    },
    "nonclaim": {
      "const": "This pre-execution package is MODEL_OUTPUT only and grants no registry or scientific-propagation authority."
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "const": "58b57094d519205f3ef398f3c738af96107c59e5"
    },
    "positiveSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256",
        "schema"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "schemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256"
      ],
      "properties": {
        "schema": {
          "enum": [
            "jx-v5-solar-1pn-qualification-plan/v1",
            "jx-v5-solar-1pn-qualification-inputs/v1",
            "jx-v5-solar-1pn-qualification-registration/v1",
            "jx-v5-solar-1pn-prior-development-cases/v1"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "knownPriorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_commit",
        "disclosure_status",
        "known_fixture_ids",
        "known_state_fingerprints",
        "manifest_disclosure_sha256",
        "known_case_descriptor_sha256s",
        "generated_family_fingerprint_list_sha256s",
        "excluded_from_decisive_gates"
      ],
      "properties": {
        "development_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "disclosure_status": {
          "const": "DISCLOSED_BEFORE_HOLDOUT_EXECUTION"
        },
        "known_fixture_ids": {
          "$ref": "#/$defs/identifierArray"
        },
        "known_state_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "manifest_disclosure_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "known_case_descriptor_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "generated_family_fingerprint_list_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "excluded_from_decisive_gates": {
          "const": true
        }
      }
    },
    "priorDevelopmentManifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256",
        "schema",
        "manifest_id"
      ],
      "properties": {
        "role": {
          "const": "prior_development_cases_manifest"
        },
        "path": {
          "const": "runs/v5_solar_1pn_qualification/prior_development_cases_v1.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "const": "jx-v5-solar-1pn-prior-development-cases/v1"
        },
        "manifest_id": {
          "const": "jx.v5.solar_1pn.prior_development_cases.v1"
        }
      }
    },
    "blockingStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q0_q9_execution_status",
        "ready_for_holdout_execution",
        "unresolved_blocker_codes"
      ],
      "properties": {
        "q0_q9_execution_status": {
          "const": "NOT_EXECUTED"
        },
        "ready_for_holdout_execution": {
          "const": false
        },
        "unresolved_blocker_codes": {
          "type": "array",
          "const": [
            "EXECUTION_IMPLEMENTATION_NOT_REGISTERED",
            "Q0_Q9_NOT_EXECUTED",
            "PROVENANCE_UNRESOLVED",
            "INDEPENDENT_ORACLE_UNRESOLVED",
            "EIH_EVALUATOR_UNRESOLVED",
            "ERROR_BUDGETS_UNRESOLVED",
            "HOLDOUT_CUSTODY_UNRESOLVED"
          ]
        }
      }
    }
  }
}
