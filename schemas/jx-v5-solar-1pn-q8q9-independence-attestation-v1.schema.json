{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q8q9-independence-attestation-v1.schema.json",
  "title": "JX V5 Solar 1PN external scientific independence attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "predecessor_package_sha256",
    "attestation_role",
    "status",
    "phase_required",
    "reviewer_identity",
    "reviewer_organization",
    "signing_key_id",
    "relationship_to_implementation_team",
    "conflicts_of_interest_statement",
    "oracle_independence_accepted",
    "eih_independence_accepted",
    "budget_review_independence_accepted",
    "reviewed_source_bindings",
    "attested_utc",
    "signature",
    "external_attestation_artifact",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-q8q9-independence-attestation-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-q8q9-independence-attestation/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "predecessor_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attestation_role": {
      "const": "EXTERNAL_SCIENTIFIC_INDEPENDENCE_REVIEW"
    },
    "status": {
      "enum": [
        "AWAITING_EXTERNAL_INDEPENDENCE_ATTESTATION",
        "EXTERNAL_INDEPENDENCE_ACCEPTED",
        "INVALIDATED"
      ]
    },
    "phase_required": {
      "const": "BEFORE_EXECUTION"
    },
    "reviewer_identity": {
      "$ref": "#/$defs/nullableString"
    },
    "reviewer_organization": {
      "$ref": "#/$defs/nullableString"
    },
    "signing_key_id": {
      "$ref": "#/$defs/nullableString"
    },
    "relationship_to_implementation_team": {
      "$ref": "#/$defs/nullableString"
    },
    "conflicts_of_interest_statement": {
      "$ref": "#/$defs/nullableString"
    },
    "oracle_independence_accepted": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "eih_independence_accepted": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "budget_review_independence_accepted": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "reviewed_source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "attested_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "signature": {
      "$ref": "#/$defs/nullableString"
    },
    "external_attestation_artifact": {
      "$ref": "#/$defs/externalArtifactSlot"
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableTimestamp": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      }
    },
    "nullableRepositoryPath": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "nullablePositiveSize": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "nullableBoolean": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "boolean"
      }
    },
    "externalArtifactSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "size_bytes",
        "sha256",
        "canonical_sha256",
        "signed_utc",
        "signature"
      ],
      "properties": {
        "status": {
          "enum": [
            "AWAITING_EXTERNAL_ATTESTATION_ARTIFACT",
            "EXTERNAL_ATTESTATION_ARTIFACT_BOUND",
            "INVALIDATED"
          ]
        },
        "path": {
          "$ref": "#/$defs/nullableRepositoryPath"
        },
        "size_bytes": {
          "$ref": "#/$defs/nullablePositiveSize"
        },
        "sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        },
        "canonical_sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        },
        "signed_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "signature": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
