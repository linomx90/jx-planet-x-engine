{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q8q9-unblinding-record-v1.schema.json",
  "title": "JX V5 Solar 1PN first-valid unblinding record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "predecessor_package_sha256",
    "status",
    "phase_required",
    "custody_state_required",
    "first_valid_unblinding_only",
    "post_unblinding_tuning_allowed",
    "selective_retry_allowed",
    "failed_record_retention_required",
    "outcomes_generated",
    "output_manifest_status",
    "output_manifest_path",
    "output_manifest_size_bytes",
    "output_manifest_sha256",
    "output_manifest_canonical_sha256",
    "output_committed_utc",
    "unblind_request_utc",
    "custodian_authorization_signature",
    "sealed_expectation_commitment_sha256",
    "revealed_nonce_hex",
    "revealed_expectation_package_path",
    "revealed_expectation_package_sha256",
    "revealed_expectation_package_canonical_sha256",
    "commitment_verified",
    "valid_unblinding_ordinal",
    "second_unblinding_attempted",
    "adjudication_status",
    "adjudication_verdict",
    "adjudicated_utc",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-q8q9-unblinding-record-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-q8q9-unblinding-record/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "predecessor_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "AWAITING_EXTERNAL_OUTPUT_COMMIT_CONFIRMATION",
        "UNBLIND_REQUESTED",
        "UNBLINDED_FIRST_VALID",
        "ADJUDICATED_RETAINED",
        "INVALIDATED"
      ]
    },
    "phase_required": {
      "const": "AFTER_OUTPUT_COMMIT_BEFORE_ADJUDICATION"
    },
    "custody_state_required": {
      "const": "OUTPUTS_COMMITTED_EXPECTATIONS_SEALED"
    },
    "first_valid_unblinding_only": {
      "const": true
    },
    "post_unblinding_tuning_allowed": {
      "const": false
    },
    "selective_retry_allowed": {
      "const": false
    },
    "failed_record_retention_required": {
      "const": true
    },
    "outcomes_generated": {
      "type": "boolean"
    },
    "output_manifest_status": {
      "enum": [
        "NOT_APPLICABLE_PREEXECUTION",
        "OUTPUTS_COMMITTED_EXPECTATIONS_SEALED",
        "INVALIDATED"
      ]
    },
    "output_manifest_path": {
      "$ref": "#/$defs/nullableRepositoryPath"
    },
    "output_manifest_size_bytes": {
      "$ref": "#/$defs/nullablePositiveSize"
    },
    "output_manifest_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "output_manifest_canonical_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "output_committed_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "unblind_request_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "custodian_authorization_signature": {
      "$ref": "#/$defs/nullableString"
    },
    "sealed_expectation_commitment_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "revealed_nonce_hex": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "revealed_expectation_package_path": {
      "$ref": "#/$defs/nullableRepositoryPath"
    },
    "revealed_expectation_package_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "revealed_expectation_package_canonical_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "commitment_verified": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "valid_unblinding_ordinal": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "const": 1
      }
    },
    "second_unblinding_attempted": {
      "type": "boolean"
    },
    "adjudication_status": {
      "enum": [
        "NOT_APPLICABLE_PREEXECUTION",
        "AWAITING_ADJUDICATION",
        "ADJUDICATED_RETAINED",
        "INVALIDATED"
      ]
    },
    "adjudication_verdict": {
      "enum": [
        null,
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "adjudicated_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableSha256": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nullableTimestamp": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      }
    },
    "nullableBoolean": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "boolean"
      }
    },
    "nullableRepositoryPath": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "nullablePositiveSize": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    }
  }
}
