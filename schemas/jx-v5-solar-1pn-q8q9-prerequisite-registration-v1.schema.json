{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q8q9-prerequisite-registration-v1.schema.json",
  "title": "JX V5 Solar 1PN Q8/Q9 prerequisite registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "prerequisite_package_id",
    "predecessor",
    "status",
    "scientific_evidence_artifact",
    "outcomes_generated",
    "execution_authorized",
    "ready_for_holdout_execution",
    "unblinding_occurred",
    "lifecycle",
    "artifacts",
    "schemas",
    "verifier",
    "readme",
    "blocked_reasons",
    "claim_control",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-q8q9-prerequisite-registration-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-q8q9-prerequisite-registration/v1"
    },
    "prerequisite_package_id": {
      "const": "jx.v5.solar_1pn.q8q9_prerequisites.v1"
    },
    "predecessor": {
      "$ref": "#/$defs/predecessor"
    },
    "status": {
      "enum": [
        "DESIGN_ONLY_BLOCKED",
        "READY_NONAUTHORIZING",
        "RUNNING_NONAUTHORIZING",
        "COMPLETE_NONAUTHORIZING",
        "INVALIDATED"
      ]
    },
    "scientific_evidence_artifact": {
      "type": "boolean"
    },
    "outcomes_generated": {
      "type": "boolean"
    },
    "execution_authorized": {
      "type": "boolean"
    },
    "ready_for_holdout_execution": {
      "type": "boolean"
    },
    "unblinding_occurred": {
      "type": "boolean"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/typedArtifactBinding"
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/typedArtifactBinding"
      }
    },
    "verifier": {
      "$ref": "#/$defs/fileBinding"
    },
    "readme": {
      "$ref": "#/$defs/fileBinding"
    },
    "blocked_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "claim_control": {
      "$ref": "#/$defs/claimControl"
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "positiveSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "typedArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "schema",
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_id",
        "package_sha256",
        "commit",
        "plan",
        "inputs",
        "registration"
      ],
      "properties": {
        "qualification_id": {
          "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$",
          "type": "string"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "plan": {
          "$ref": "#/$defs/artifactBinding"
        },
        "inputs": {
          "$ref": "#/$defs/artifactBinding"
        },
        "registration": {
          "$ref": "#/$defs/artifactBinding"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_states",
        "custody_states",
        "error_budget_states",
        "phase_requirements"
      ],
      "properties": {
        "qualification_states": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "custody_states": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "error_budget_states": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "phase_requirements": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "required_artifact_roles"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "BEFORE_EXECUTION",
                  "AFTER_EXECUTION_BEFORE_UNBLIND",
                  "AFTER_OUTPUT_COMMIT_BEFORE_ADJUDICATION"
                ]
              },
              "required_artifact_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      }
    },
    "claimControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_emitted",
        "claim_text",
        "maximum_future_claim_effect"
      ],
      "properties": {
        "claim_emitted": {
          "type": "boolean"
        },
        "claim_text": {
          "enum": [
            null
          ]
        },
        "maximum_future_claim_effect": {
          "const": "ELIGIBLE_FOR_EXTERNAL_REVIEW_NONAUTHORIZING_ONLY"
        }
      }
    },
    "nullableString": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableSha256": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nullableTimestamp": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      }
    },
    "externalArtifactSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "target_schema",
        "status",
        "phase_required",
        "path",
        "size_bytes",
        "sha256",
        "canonical_sha256",
        "signer_identity",
        "signing_key_id",
        "signed_utc",
        "signature"
      ],
      "properties": {
        "role": {
          "enum": [
            "custody_attestation",
            "independence_attestation",
            "sealed_expectation_commitment",
            "unblinding_record"
          ]
        },
        "target_schema": {
          "enum": [
            "jx-v5-solar-1pn-q8q9-custody-attestation/v1",
            "jx-v5-solar-1pn-q8q9-independence-attestation/v1",
            "jx-v5-solar-1pn-q8q9-sealed-expectation-commitment/v1",
            "jx-v5-solar-1pn-q8q9-unblinding-record/v1"
          ]
        },
        "status": {
          "enum": [
            "AWAITING_EXTERNAL_CUSTODIAN_ATTESTATION",
            "AWAITING_EXTERNAL_INDEPENDENCE_ATTESTATION",
            "AWAITING_EXTERNAL_SEALED_EXPECTATION_COMMITMENT",
            "NOT_APPLICABLE_PREEXECUTION"
          ]
        },
        "phase_required": {
          "enum": [
            "BEFORE_EXECUTION",
            "AFTER_OUTPUT_COMMIT_BEFORE_ADJUDICATION"
          ]
        },
        "path": {
          "$ref": "#/$defs/nullableString"
        },
        "size_bytes": {
          "$ref": "#/$defs/nullableString"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "signer_identity": {
          "$ref": "#/$defs/nullableString"
        },
        "signing_key_id": {
          "$ref": "#/$defs/nullableString"
        },
        "signed_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "signature": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "externalArtifactSlotsDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema",
        "qualification_id",
        "predecessor_package_sha256",
        "status",
        "slots",
        "nonclaim"
      ],
      "properties": {
        "$schema": {
          "const": "../../schemas/jx-v5-solar-1pn-q8q9-prerequisite-registration-v1.schema.json#/$defs/externalArtifactSlotsDocument"
        },
        "schema": {
          "const": "jx-v5-solar-1pn-q8q9-external-artifact-slots/v1"
        },
        "qualification_id": {
          "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$",
          "type": "string"
        },
        "predecessor_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "DESIGN_ONLY_BLOCKED"
        },
        "slots": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/externalArtifactSlot"
          }
        },
        "nonclaim": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
