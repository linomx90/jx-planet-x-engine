{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-qualification-plan-v1.schema.json",
  "title": "JX V5 Solar 1PN reference qualification plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "state",
    "registered_utc",
    "foundation_commit",
    "prior_development_evidence",
    "scope",
    "bindings",
    "all_gates_conjunctive",
    "result_semantics",
    "test_arms",
    "gates",
    "execution_registration_policy",
    "verdict_policy",
    "limitations",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-qualification-plan-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-qualification-plan/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "state": {
      "const": "PRELOCKED_AFTER_DISCLOSED_DEVELOPMENT_TESTS_BEFORE_HOLDOUT_OUTCOMES"
    },
    "registered_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "foundation_commit": {
      "const": "58b57094d519205f3ef398f3c738af96107c59e5"
    },
    "prior_development_evidence": {
      "$ref": "#/$defs/priorDevelopmentEvidence"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "all_gates_conjunctive": {
      "const": true
    },
    "result_semantics": {
      "$ref": "#/$defs/resultSemantics"
    },
    "test_arms": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/testArm"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "execution_registration_policy": {
      "$ref": "#/$defs/executionRegistrationPolicy"
    },
    "verdict_policy": {
      "$ref": "#/$defs/verdictPolicy"
    },
    "limitations": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "nonclaim": {
      "const": "This pre-execution package is MODEL_OUTPUT only and grants no registry or scientific-propagation authority."
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "armId": {
      "enum": [
        "arm.q0_integrity",
        "arm.q1_equation",
        "arm.q2_perihelion",
        "arm.q3_high_order_oracle",
        "arm.q4_restricted_eih",
        "arm.q5_step_solver",
        "arm.q6_precision",
        "arm.q7_transform",
        "arm.q8_holdout",
        "arm.q9_claim_audit"
      ]
    },
    "gateId": {
      "enum": [
        "gate.q0_package_integrity",
        "gate.q1_equation_discrimination",
        "gate.q2_perihelion_coefficient",
        "gate.q3_high_order_oracle",
        "gate.q4_restricted_eih_limit",
        "gate.q5_step_solver_convergence",
        "gate.q6_decimal_precision",
        "gate.q7_unit_time_transform",
        "gate.q8_first_unblinding",
        "gate.q9_claim_audit"
      ]
    },
    "caseRole": {
      "enum": [
        "GENERIC_3D",
        "ECCENTRIC",
        "LONG_ARC",
        "DOMAIN_INSIDE",
        "DOMAIN_BOUNDARY",
        "DOMAIN_OUTSIDE",
        "TRANSFORM_TWIN",
        "SIGNAL_SCALE",
        "EIH_LIMIT"
      ]
    },
    "observableId": {
      "enum": [
        "observable.q1.acceleration",
        "observable.q2.perihelion_coefficient",
        "observable.q3.total_state",
        "observable.q3.differential_signal",
        "observable.q4.eih_restricted_limit",
        "observable.q5.order_solver",
        "observable.q6.precision_plateau",
        "observable.q7.transform"
      ]
    },
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "const": "58b57094d519205f3ef398f3c738af96107c59e5"
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "positiveSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "identifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        }
      }
    },
    "typedArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        }
      }
    },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256",
        "schema",
        "registry_id",
        "state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "const": "jx-force-parameter-registry/v5"
        },
        "registry_id": {
          "const": "jx.force_parameter_registry.v5.draft"
        },
        "state": {
          "const": "DRAFT_NONEXECUTABLE"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256",
        "schema",
        "input_id"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "const": "jx-v5-solar-1pn-qualification-inputs/v1"
        },
        "input_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "priorDevelopmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_commit",
        "disclosure_status",
        "known_files",
        "known_fixture_ids",
        "known_state_records",
        "known_state_record_count",
        "manifest_disclosure_sha256",
        "known_case_descriptor_sha256s",
        "generated_family_fingerprint_list_sha256s",
        "excluded_from_decisive_gates"
      ],
      "properties": {
        "development_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "disclosure_status": {
          "const": "DISCLOSED_BEFORE_HOLDOUT_EXECUTION"
        },
        "known_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typedArtifactBinding"
          }
        },
        "known_fixture_ids": {
          "$ref": "#/$defs/identifierArray"
        },
        "known_state_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/knownStateRecord"
          }
        },
        "known_state_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_disclosure_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "known_case_descriptor_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "generated_family_fingerprint_list_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "excluded_from_decisive_gates": {
          "const": true
        }
      }
    },
    "coefficientSnapshotValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit_id"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "unit_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "coefficientSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central_source",
        "gravitational_parameter",
        "speed_of_light",
        "maximum_compactness",
        "maximum_speed_fraction_squared"
      ],
      "properties": {
        "central_source": {
          "const": "SUN"
        },
        "gravitational_parameter": {
          "$ref": "#/$defs/coefficientSnapshotValue"
        },
        "speed_of_light": {
          "$ref": "#/$defs/coefficientSnapshotValue"
        },
        "maximum_compactness": {
          "$ref": "#/$defs/coefficientSnapshotValue"
        },
        "maximum_speed_fraction_squared": {
          "$ref": "#/$defs/coefficientSnapshotValue"
        }
      }
    },
    "coordinateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "frame",
        "origin",
        "orientation",
        "time_scale",
        "epoch_kind",
        "central_source_model",
        "target_treatment",
        "output_semantics",
        "length_unit_ref",
        "time_unit_ref",
        "velocity_unit_ref",
        "gravitational_parameter_unit_ref"
      ],
      "properties": {
        "units": {
          "enum": [
            "AU_DAY",
            "KILOMETRE_SECOND"
          ]
        },
        "frame": {
          "const": "BCRS_DERIVED_SUN_RELATIVE_ICRS_ALIGNED_RESTRICTED"
        },
        "origin": {
          "const": "SUN"
        },
        "orientation": {
          "const": "ICRS_ALIGNED_RESTRICTED"
        },
        "time_scale": {
          "enum": [
            "TCB_COMPATIBLE",
            "TDB_COMPATIBLE"
          ]
        },
        "epoch_kind": {
          "enum": [
            "SYNTHETIC_COORDINATE_OFFSET",
            "DECLARED_COORDINATE_EPOCH"
          ]
        },
        "central_source_model": {
          "const": "STATIC_SPHERICAL_SOLAR_MONOPOLE"
        },
        "target_treatment": {
          "const": "MASSLESS_NO_BACKREACTION"
        },
        "output_semantics": {
          "const": "CORRECTION_ONLY"
        },
        "length_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "time_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "velocity_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "gravitational_parameter_unit_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "knownStateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_role",
        "source_locator",
        "alias_locators",
        "target",
        "epoch",
        "position",
        "velocity",
        "coordinate_contract",
        "coefficient_contract",
        "scientific_fingerprint_sha256"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_role": {
          "enum": [
            "development_solar_1pn_tests",
            "development_reference_integrator_tests"
          ]
        },
        "source_locator": {
          "$ref": "#/$defs/nonemptyString"
        },
        "alias_locators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "epoch": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/canonicalDecimal"
          }
        },
        "velocity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/canonicalDecimal"
          }
        },
        "coordinate_contract": {
          "$ref": "#/$defs/coordinateSnapshot"
        },
        "coefficient_contract": {
          "$ref": "#/$defs/coefficientSnapshot"
        },
        "scientific_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resultSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_result_verdict",
        "skipped_result_verdict",
        "nonfinite_result_verdict",
        "gate_failure_verdict",
        "conflict_verdict"
      ],
      "properties": {
        "missing_result_verdict": {
          "const": "BLOCKED"
        },
        "skipped_result_verdict": {
          "const": "BLOCKED"
        },
        "nonfinite_result_verdict": {
          "const": "FAIL"
        },
        "gate_failure_verdict": {
          "const": "FAIL"
        },
        "conflict_verdict": {
          "const": "CONFLICT"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "force_model_ids",
        "integrator_method_id",
        "central_source",
        "central_source_model",
        "target_treatment",
        "output_semantics",
        "output_evidence_class",
        "registry_authorized",
        "registry_state_after_pass",
        "force_implementation_status_after_pass",
        "force_qualification_status_after_pass"
      ],
      "properties": {
        "force_model_ids": {
          "type": "array",
          "const": [
            "force.newtonian.point_mass",
            "relativity.solar_schwarzschild_test_particle_1pn"
          ]
        },
        "integrator_method_id": {
          "const": "jx.v5.reference.implicit_midpoint.fixed_step_decimal.v1"
        },
        "central_source": {
          "const": "SUN"
        },
        "central_source_model": {
          "const": "STATIC_SPHERICAL_SOLAR_MONOPOLE"
        },
        "target_treatment": {
          "const": "MASSLESS_NO_BACKREACTION"
        },
        "output_semantics": {
          "const": "CORRECTION_ONLY_PLUS_EXACTLY_ONE_NEWTONIAN_BASE"
        },
        "output_evidence_class": {
          "const": "MODEL_OUTPUT"
        },
        "registry_authorized": {
          "const": false
        },
        "registry_state_after_pass": {
          "const": "DRAFT_NONEXECUTABLE"
        },
        "force_implementation_status_after_pass": {
          "const": "NOT_IMPLEMENTED"
        },
        "force_qualification_status_after_pass": {
          "const": "UNQUALIFIED"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "prior_development_manifest",
        "registry",
        "scientific_contract",
        "locked_files"
      ],
      "properties": {
        "inputs": {
          "$ref": "#/$defs/inputBinding"
        },
        "prior_development_manifest": {
          "$ref": "#/$defs/priorDevelopmentManifestBinding"
        },
        "registry": {
          "$ref": "#/$defs/registryBinding"
        },
        "scientific_contract": {
          "$ref": "#/$defs/artifactBinding"
        },
        "locked_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typedArtifactBinding"
          }
        }
      }
    },
    "priorDevelopmentManifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes",
        "canonical_sha256",
        "schema",
        "manifest_id"
      ],
      "properties": {
        "role": {
          "const": "prior_development_cases_manifest"
        },
        "path": {
          "const": "runs/v5_solar_1pn_qualification/prior_development_cases_v1.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "const": "jx-v5-solar-1pn-prior-development-cases/v1"
        },
        "manifest_id": {
          "const": "jx.v5.solar_1pn.prior_development_cases.v1"
        }
      }
    },
    "testArm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "purpose_code",
        "purpose",
        "fixture_refs",
        "gate_refs",
        "implementation_independence",
        "required_case_roles",
        "observable_refs",
        "budget_refs",
        "readiness_state",
        "blocked_artifact_refs"
      ],
      "properties": {
        "arm_id": {
          "$ref": "#/$defs/armId"
        },
        "purpose_code": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fixture_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "gate_refs": {
          "$ref": "#/$defs/identifierArray"
        },
        "implementation_independence": {
          "enum": [
            "PROVENANCE_ONLY",
            "ANALYTIC_OR_EXACT",
            "JX_REFERENCE_IMPLEMENTATION",
            "SEPARATELY_CODED_NO_JX_DYNAMICS_IMPORTS"
          ]
        },
        "required_case_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseRole"
          }
        },
        "observable_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observableId"
          }
        },
        "budget_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observableId"
          }
        },
        "readiness_state": {
          "const": "BLOCKED"
        },
        "blocked_artifact_refs": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "metric_code",
        "metric",
        "value_kind",
        "operator",
        "threshold",
        "unit",
        "observable_refs",
        "budget_refs",
        "arm_refs",
        "failure_verdict",
        "readiness_state",
        "blocked_artifact_refs"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/gateId"
        },
        "metric_code": {
          "$ref": "#/$defs/identifier"
        },
        "metric": {
          "$ref": "#/$defs/nonemptyString"
        },
        "value_kind": {
          "enum": [
            "BOOLEAN",
            "DECIMAL",
            "INTEGER",
            "ENUM"
          ]
        },
        "operator": {
          "enum": [
            "EQUAL",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "IN_CLOSED_INTERVAL"
          ]
        },
        "threshold": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit": {
          "$ref": "#/$defs/identifier"
        },
        "observable_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observableId"
          }
        },
        "budget_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observableId"
          }
        },
        "arm_refs": {
          "$ref": "#/$defs/identifierArray"
        },
        "failure_verdict": {
          "enum": [
            "FAIL",
            "INVALID",
            "CONFLICT",
            "BLOCKED"
          ]
        },
        "readiness_state": {
          "const": "BLOCKED"
        },
        "blocked_artifact_refs": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    },
    "executionRegistrationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "current_state",
        "outcomes_prohibited_until_registered",
        "required_bindings"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "current_state": {
          "const": "NOT_REGISTERED"
        },
        "outcomes_prohibited_until_registered": {
          "const": true
        },
        "required_bindings": {
          "$ref": "#/$defs/nonemptyStringArray"
        }
      }
    },
    "verdictPolicy": {
      "type": "object",
      "additionalProperties": false,
