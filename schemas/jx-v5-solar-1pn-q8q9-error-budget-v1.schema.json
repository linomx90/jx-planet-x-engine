{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q8q9-error-budget-v1.schema.json",
  "title": "JX V5 Solar 1PN Q9 conservative error-budget prerequisite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "predecessor_package_sha256",
    "budget_id",
    "status",
    "phase_required",
    "combination_rule",
    "component_order",
    "observables",
    "external_scientific_review",
    "postrun_realized_errors_status",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-q8q9-error-budget-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-q8q9-error-budget/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "predecessor_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "budget_id": {
      "const": "jx.v5.solar_1pn.q9.error_budget.v1"
    },
    "status": {
      "enum": [
        "UNRESOLVED",
        "DRAFT_UNREVIEWED",
        "FROZEN_AWAITING_EXTERNAL_REVIEW",
        "INDEPENDENTLY_REVIEWED_AND_FROZEN",
        "INVALIDATED"
      ]
    },
    "phase_required": {
      "const": "BEFORE_EXECUTION"
    },
    "combination_rule": {
      "const": "CONSERVATIVE_SUM"
    },
    "component_order": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "observables": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/observableBudget"
      }
    },
    "external_scientific_review": {
      "$ref": "#/$defs/externalReview"
    },
    "postrun_realized_errors_status": {
      "enum": [
        "NOT_APPLICABLE_PREEXECUTION",
        "BOUND_SEPARATELY_AFTER_EXECUTION",
        "INVALIDATED"
      ]
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "nullableString": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableTimestamp": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      }
    },
    "nullableDecimal": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "zeroScopeProof": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_class",
          "proof_statement",
          "evidence_bindings"
        ],
        "properties": {
          "scope_class": {
            "const": "SYNTHETIC_SAME_EQUATION"
          },
          "proof_statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_bindings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidenceBinding"
            }
          }
        }
      }
    },
    "componentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "status",
        "allocation",
        "unit_ref",
        "derivation_class",
        "evidence_bindings",
        "review_status",
        "exact_zero_scope_proof"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "AWAITING_EXTERNAL_BUDGET",
            "ALLOCATED_UNREVIEWED",
            "FROZEN_AWAITING_EXTERNAL_REVIEW",
            "INDEPENDENTLY_REVIEWED_AND_FROZEN",
            "INVALIDATED"
          ]
        },
        "allocation": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "derivation_class": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "enum": [
              "MEASURED_BOUND",
              "ANALYTIC_BOUND",
              "NUMERICAL_CONVERGENCE_BOUND",
              "PROPAGATED_COVARIANCE_BOUND",
              "CONSERVATIVE_ASSUMPTION",
              "EXACT_ZERO_PROVED"
            ]
          }
        },
        "evidence_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceBinding"
          }
        },
        "review_status": {
          "enum": [
            "AWAITING_EXTERNAL_REVIEW",
            "EXTERNAL_REVIEW_ACCEPTED",
            "EXTERNAL_REVIEW_REJECTED",
            "INVALIDATED"
          ]
        },
        "exact_zero_scope_proof": {
          "$ref": "#/$defs/zeroScopeProof"
        }
      }
    },
    "observableBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_id",
        "status",
        "unit_ref",
        "norm_status",
        "norm",
        "scope_status",
        "scope",
        "acceptance_relation",
        "discrimination_margin_status",
        "discrimination_margin",
        "components",
        "total_status",
        "total_allocation"
      ],
      "properties": {
        "observable_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "UNRESOLVED",
            "DRAFT_UNREVIEWED",
            "FROZEN_AWAITING_EXTERNAL_REVIEW",
            "INDEPENDENTLY_REVIEWED_AND_FROZEN",
            "INVALIDATED"
          ]
        },
        "unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "norm_status": {
          "enum": [
            "AWAITING_EXTERNAL_NORM",
            "FROZEN",
            "INVALIDATED"
          ]
        },
        "norm": {
          "$ref": "#/$defs/nullableString"
        },
        "scope_status": {
          "enum": [
            "AWAITING_EXTERNAL_SCOPE",
            "FROZEN",
            "INVALIDATED"
          ]
        },
        "scope": {
          "$ref": "#/$defs/nullableString"
        },
        "acceptance_relation": {
          "const": "DISCREPANCY_LE_TOTAL_AND_EACH_REALIZED_COMPONENT_LE_ALLOCATION"
        },
        "discrimination_margin_status": {
          "enum": [
            "AWAITING_EXTERNAL_MARGIN",
            "FROZEN",
            "INVALIDATED"
          ]
        },
        "discrimination_margin": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "components": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentBudget"
          }
        },
        "total_status": {
          "enum": [
            "AWAITING_EXTERNAL_BUDGET",
            "CONSERVATIVE_SUM_FROZEN",
            "INVALIDATED"
          ]
        },
        "total_allocation": {
          "$ref": "#/$defs/nullableDecimal"
        }
      }
    },
    "externalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_identity",
        "reviewer_organization",
        "signing_key_id",
        "scientific_acceptance_statement",
        "reviewed_utc",
        "signature"
      ],
      "properties": {
        "status": {
          "enum": [
            "AWAITING_EXTERNAL_BUDGET_REVIEW",
            "EXTERNAL_BUDGET_REVIEW_ACCEPTED",
            "EXTERNAL_BUDGET_REVIEW_REJECTED",
            "INVALIDATED"
          ]
        },
        "reviewer_identity": {
          "$ref": "#/$defs/nullableString"
        },
        "reviewer_organization": {
          "$ref": "#/$defs/nullableString"
        },
        "signing_key_id": {
          "$ref": "#/$defs/nullableString"
        },
        "scientific_acceptance_statement": {
          "$ref": "#/$defs/nullableString"
        },
        "reviewed_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "signature": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
