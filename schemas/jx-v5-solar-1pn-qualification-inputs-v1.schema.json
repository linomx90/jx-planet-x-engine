{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-qualification-inputs-v1.schema.json",
  "title": "JX V5 Solar 1PN frozen nonauthorizing qualification inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "input_id",
    "state",
    "evidence_policy",
    "unit_definitions",
    "coordinate_contracts",
    "coefficient_sets",
    "decimal_contexts",
    "integration_schedules",
    "fixtures",
    "provenance_sources",
    "derivations",
    "blocked_artifacts",
    "q2_perihelion_observer",
    "q3_independent_oracle",
    "q4_eih_evaluator",
    "q5_convergence_grid",
    "q6_precision_cross_grid",
    "q7_transform_contract",
    "q8_holdout_custody",
    "q9_error_budgets",
    "claim_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-qualification-inputs-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-qualification-inputs/v1"
    },
    "input_id": {
      "$ref": "#/$defs/identifier"
    },
    "state": {
      "const": "FROZEN_NONAUTHORIZING_INPUTS"
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidencePolicy"
    },
    "unit_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unitDefinition"
      }
    },
    "coordinate_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coordinateContract"
      }
    },
    "coefficient_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coefficientSet"
      }
    },
    "decimal_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decimalContext"
      }
    },
    "integration_schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/integrationSchedule"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "provenance_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenanceSource"
      }
    },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/derivation"
      }
    },
    "blocked_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/blockedArtifact"
      }
    },
    "q2_perihelion_observer": {
      "$ref": "#/$defs/q2PerihelionObserver"
    },
    "q3_independent_oracle": {
      "$ref": "#/$defs/q3IndependentOracle"
    },
    "q4_eih_evaluator": {
      "$ref": "#/$defs/q4EihEvaluator"
    },
    "q5_convergence_grid": {
      "$ref": "#/$defs/q5ConvergenceGrid"
    },
    "q6_precision_cross_grid": {
      "$ref": "#/$defs/q6PrecisionCrossGrid"
    },
    "q7_transform_contract": {
      "$ref": "#/$defs/q7TransformContract"
    },
    "q8_holdout_custody": {
      "$ref": "#/$defs/q8HoldoutCustody"
    },
    "q9_error_budgets": {
      "$ref": "#/$defs/q9ErrorBudgets"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "caseRole": {
      "enum": [
        "GENERIC_3D",
        "ECCENTRIC",
        "LONG_ARC",
        "DOMAIN_INSIDE",
        "DOMAIN_BOUNDARY",
        "DOMAIN_OUTSIDE",
        "TRANSFORM_TWIN",
        "SIGNAL_SCALE",
        "EIH_LIMIT"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_evidence_class",
        "registry_authorized",
        "parameter_values_are_registry_resolutions",
        "gm_uncertainty_propagated",
        "domain_bounds_are_physical_error_budget"
      ],
      "properties": {
        "output_evidence_class": {
          "const": "MODEL_OUTPUT"
        },
        "registry_authorized": {
          "const": false
        },
        "parameter_values_are_registry_resolutions": {
          "const": false
        },
        "gm_uncertainty_propagated": {
          "const": false
        },
        "domain_bounds_are_physical_error_budget": {
          "const": false
        }
      }
    },
    "unitDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "symbol",
        "quantity_dimension",
        "definition_kind",
        "definition",
        "provenance_refs"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "symbol": {
          "$ref": "#/$defs/nonemptyString"
        },
        "quantity_dimension": {
          "$ref": "#/$defs/nonemptyString"
        },
        "definition_kind": {
          "enum": [
            "EXACT_DEFINITION",
            "DERIVED_EXACT",
            "FIXED_SCENARIO"
          ]
        },
        "definition": {
          "$ref": "#/$defs/nonemptyString"
        },
        "provenance_refs": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    },
    "coordinateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_contract_id",
        "units",
        "frame",
        "origin",
        "orientation",
        "time_scale",
        "epoch_kind",
        "central_source_model",
        "target_treatment",
        "output_semantics",
        "length_unit_ref",
        "time_unit_ref",
        "velocity_unit_ref",
        "gravitational_parameter_unit_ref"
      ],
      "properties": {
        "coordinate_contract_id": {
          "$ref": "#/$defs/identifier"
        },
        "units": {
          "enum": [
            "AU_DAY",
            "KILOMETRE_SECOND"
          ]
        },
        "frame": {
          "const": "BCRS_DERIVED_SUN_RELATIVE_ICRS_ALIGNED_RESTRICTED"
        },
        "origin": {
          "const": "SUN"
        },
        "orientation": {
          "const": "ICRS_ALIGNED_RESTRICTED"
        },
        "time_scale": {
          "enum": [
            "TCB_COMPATIBLE",
            "TDB_COMPATIBLE"
          ]
        },
        "epoch_kind": {
          "enum": [
            "SYNTHETIC_COORDINATE_OFFSET",
            "DECLARED_COORDINATE_EPOCH"
          ]
        },
        "central_source_model": {
          "const": "STATIC_SPHERICAL_SOLAR_MONOPOLE"
        },
        "target_treatment": {
          "const": "MASSLESS_NO_BACKREACTION"
        },
        "output_semantics": {
          "const": "CORRECTION_ONLY"
        },
        "length_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "time_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "velocity_unit_ref": {
          "$ref": "#/$defs/identifier"
        },
        "gravitational_parameter_unit_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit_id",
        "value_role",
        "uncertainty_status",
        "provenance_refs",
        "derivation_ref",
        "derivation_result_name"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "value_role": {
          "enum": [
            "EXACT_DEFINITION",
            "FIXED_SOURCE_LITERAL_REFERENCE_ONLY",
            "FIXED_SCENARIO_ASSUMPTION",
            "DERIVED_COMPATIBLE_VALUE"
          ]
        },
        "uncertainty_status": {
          "enum": [
            "EXACT_DEFINITION",
            "SOURCE_UNCERTAINTY_NOT_PROPAGATED_REFERENCE_ONLY",
            "NOT_APPLICABLE_FIXED_SCENARIO"
          ]
        },
        "provenance_refs": {
          "$ref": "#/$defs/identifierArray"
        },
        "derivation_ref": {
          "$ref": "#/$defs/identifier"
        },
        "derivation_result_name": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "coefficientSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coefficient_set_id",
        "coordinate_contract_ref",
        "central_source",
        "gravitational_parameter",
        "speed_of_light",
        "maximum_compactness",
        "maximum_speed_fraction_squared",
        "expected_force_plan_sha256"
      ],
      "properties": {
        "coefficient_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "coordinate_contract_ref": {
          "$ref": "#/$defs/identifier"
        },
        "central_source": {
          "const": "SUN"
        },
        "gravitational_parameter": {
          "$ref": "#/$defs/coefficient"
        },
        "speed_of_light": {
          "$ref": "#/$defs/coefficient"
        },
        "maximum_compactness": {
          "$ref": "#/$defs/coefficient"
        },
        "maximum_speed_fraction_squared": {
          "$ref": "#/$defs/coefficient"
        },
        "expected_force_plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decimalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decimal_context_id",
        "precision",
        "rounding",
        "emin",
        "emax",
        "capitals",
        "clamp",
        "traps",
        "expected_sha256"
      ],
      "properties": {
        "decimal_context_id": {
          "$ref": "#/$defs/identifier"
        },
        "precision": {
          "type": "integer"
        },
        "rounding": {
          "const": "ROUND_HALF_EVEN"
        },
        "emin": {
          "type": "integer"
        },
        "emax": {
          "type": "integer"
        },
        "capitals": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "clamp": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "traps": {
          "type": "array",
          "const": [
            "DivisionByZero",
            "FloatOperation",
            "InvalidOperation",
            "Overflow",
            "Underflow"
          ]
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "integrationSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_id",
        "fixture_ref",
        "force_model_set",
        "decimal_context_ref",
        "step_size",
        "step_count",
        "position_atol",
        "velocity_atol",
        "relative_tolerance",
        "maximum_iterations",
        "initial_guess_policy",
        "method_id",
        "expected_spec_sha256"
      ],
      "properties": {
        "schedule_id": {
          "$ref": "#/$defs/identifier"
        },
        "fixture_ref": {
          "$ref": "#/$defs/identifier"
        },
        "force_model_set": {
          "enum": [
            "NEWTONIAN_ONLY",
            "NEWTONIAN_PLUS_SOLAR_1PN"
          ]
        },
        "decimal_context_ref": {
          "$ref": "#/$defs/identifier"
        },
        "step_size": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "step_count": {
          "type": "integer"
        },
        "position_atol": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "velocity_atol": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "relative_tolerance": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "maximum_iterations": {
          "type": "integer"
        },
        "initial_guess_policy": {
          "const": "EXPLICIT_EULER_FROM_FRESH_RHS"
        },
        "method_id": {
          "const": "jx.v5.reference.implicit_midpoint.fixed_step_decimal.v1"
        },
        "expected_spec_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "derivationResultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_ref",
        "result_name"
      ],
      "properties": {
        "derivation_ref": {
          "$ref": "#/$defs/identifier"
        },
        "result_name": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "stateDerivationBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "position",
        "velocity"
      ],
      "properties": {
        "epoch": {
          "$ref": "#/$defs/derivationResultBinding"
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/derivationResultBinding"
          }
        },
        "velocity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/derivationResultBinding"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "status",
        "case_roles",
        "target",
        "epoch",
        "coefficient_set_ref",
        "coordinate_contract_ref",
        "position",
        "velocity",
        "derivation_refs",
        "state_derivation_bindings",
        "evidence_class",
        "expected_state_record_sha256"
      ],
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "HOLDOUT"
        },
        "case_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseRole"
          }
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "epoch": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "coefficient_set_ref": {
          "$ref": "#/$defs/identifier"
        },
        "coordinate_contract_ref": {
          "$ref": "#/$defs/identifier"
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/canonicalDecimal"
          }
        },
        "velocity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/canonicalDecimal"
          }
        },
        "derivation_refs": {
          "$ref": "#/$defs/identifierArray"
        },
        "state_derivation_bindings": {
          "$ref": "#/$defs/stateDerivationBindings"
        },
        "evidence_class": {
          "const": "ASSUMPTION"
        },
        "expected_state_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "status",
        "evidence_class",
        "title",
        "provider",
        "version",
        "uri",
        "path",
        "sha256",
        "size_bytes",
        "mime_type",
        "locator",
        "retrieved_utc",
        "redistribution_status"
      ],
      "properties": {
        "provenance_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "RETAINED_HASHED"
        },
        "evidence_class": {
          "enum": [
            "MEASURED",
            "RECONSTRUCTED",
            "ASSUMPTION"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "provider": {
          "$ref": "#/$defs/nonemptyString"
        },
        "version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "uri": {
          "$ref": "#/$defs/nonemptyString"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveSize"
        },
        "mime_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonemptyString"
        },
        "retrieved_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "redistribution_status": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "derivationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit_id"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "unit_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_id",
        "derivation_role",
        "formula",
        "operands",
        "results",
        "decimal_context_ref",
        "provenance_refs"
        ,"expected_signature"
      ],
      "properties": {
        "derivation_id": {
          "$ref": "#/$defs/identifier"
        },
        "derivation_role": {
          "$ref": "#/$defs/identifier"
        },
        "formula": {
          "enum": [
            "SOURCE_LITERAL",
            "FIXED_SCENARIO",
            "GM_KM3_S2_TO_AU3_DAY2",
            "C_KM_S_TO_AU_DAY",
            "NEWTONIAN_PERIAPSIS_STATE",
            "TCB_TDB_LINEAR_SCALING",
            "RATIONAL_ORTHONORMAL_BASIS"
          ]
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivationValue"
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/derivationValue"
          }
        },
        "decimal_context_ref": {
          "$ref": "#/$defs/identifier"
        },
        "provenance_refs": {
          "$ref": "#/$defs/identifierArray"
        },
        "expected_signature": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derivationSignatureItem"
          }
        }
      }
    },
    "derivationSignatureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_role",
        "name",
        "unit_id",
        "quantity_dimension"
      ],
      "properties": {
        "value_role": {
          "enum": ["OPERAND", "RESULT"]
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "quantity_dimension": {
          "enum": [
            "LENGTH",
            "TIME",
            "LENGTH/TIME",
            "LENGTH^2/TIME^2",
            "LENGTH^3/TIME^2",
            "DIMENSIONLESS"
          ]
        }
      }
    },
    "blockedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder_id",
        "status",
        "artifact_kind",
        "gate_refs",
        "resolution_requirement",
        "required_before_execution"
      ],
      "properties": {
        "placeholder_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "BLOCKED"
        },
        "artifact_kind": {
          "enum": [
            "EXECUTION_SOURCE",
            "PROVENANCE_REVIEW",
            "INDEPENDENT_EQUATION_ORACLE",
            "EVENT_OBSERVER_SOURCE",
            "EVENT_OBSERVER_RUNTIME",
            "INDEPENDENT_ORACLE_SOURCE",
            "INDEPENDENT_ORACLE_RUNTIME",
            "DEPENDENCY_LOCK",
            "METHOD_COEFFICIENTS",
            "CONFIGURATION",
            "EIH_SOURCE",
            "EIH_RUNTIME",
            "EXPECTED_OUTPUTS",
            "SELF_CONVERGENCE_OUTPUTS",
            "CUSTODIAN_ATTESTATION",
            "SEALED_EXPECTATIONS",
            "UNBLINDING_RECORD",
            "ERROR_BUDGET_JUSTIFICATION"
          ]
        },
        "gate_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "resolution_requirement": {
          "$ref": "#/$defs/nonemptyString"
        },
        "required_before_execution": {
          "const": true
        }
      }
    },
    "decimalGrid": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/canonicalDecimal"
      }
    },
    "q2CaseCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "fixture_ref",
        "newtonian_schedule_ref",
        "one_pn_schedule_ref",
        "eccentricity",
        "inverse_c_squared_value",
        "step_size",
        "event_tolerance"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/identifier"
        },
