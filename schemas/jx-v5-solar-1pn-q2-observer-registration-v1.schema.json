    "$schema": {"const": "../../schemas/jx-v5-solar-1pn-q2-observer-registration-v1.schema.json"},
    "schema": {"const": "jx-v5-solar-1pn-q2-observer-registration/v1"},
    "registration_id": {"const": "jx.v5.solar_1pn.q2_observer_registration.v1"},
    "qualification_id": {"$ref": "#/$defs/qualificationId"},
    "status": {"const": "AWAITING_EXTERNAL_Q2_OBSERVER_REGISTRATION"},
    "design_only": {"const": true},
    "outcomes_generated": {"const": false},
    "execution_authorized": {"const": false},
    "registry_authorized": {"const": false},
    "evidence_class": {"const": "MODEL_OUTPUT"},
    "protocol_constants": {"$ref": "#/$defs/protocolConstants"},
    "observer_rules": {"$ref": "#/$defs/observerRules"},
    "external_bindings": {"$ref": "#/$defs/externalBindings"},
    "ready": {"const": false},
    "nonclaim": {"const": "This null registration supplies no observer, runtime, rule completion, expectation, budget, result, or execution authority."}
  },
  "$defs": {
