{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q2-observer-registration-v1.schema.json",
  "title": "JX V5 Solar 1PN Q2 observer null registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "registration_id", "qualification_id", "status", "design_only", "outcomes_generated", "execution_authorized", "registry_authorized", "evidence_class", "protocol_constants", "observer_rules", "external_bindings", "ready", "nonclaim"],
