{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jx-planet-x-engine.invalid/schemas/jx-v5-solar-1pn-q8q9-custody-attestation-v1.schema.json",
  "title": "JX V5 Solar 1PN external holdout custody attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "qualification_id",
    "predecessor_package_sha256",
    "attestation_role",
    "status",
    "phase_required",
    "custodian_identity",
    "custodian_organization",
    "signing_key_id",
    "independence_statement",
    "conflicts_of_interest_statement",
    "no_prior_expectation_disclosure_attested",
    "holdout_freshness_attested",
    "disclosed_prior_manifest_binding",
    "holdout_manifest_binding",
    "required_case_roles",
    "covered_case_roles",
    "first_valid_unblinding_only_attested",
    "no_selective_retry_or_deletion_attested",
    "attested_utc",
    "signature",
    "external_attestation_artifact",
    "nonclaim"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/jx-v5-solar-1pn-q8q9-custody-attestation-v1.schema.json"
    },
    "schema": {
      "const": "jx-v5-solar-1pn-q8q9-custody-attestation/v1"
    },
    "qualification_id": {
      "$ref": "#/$defs/qualificationId"
    },
    "predecessor_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attestation_role": {
      "const": "EXTERNAL_HOLDOUT_CUSTODIAN"
    },
    "status": {
      "enum": [
        "AWAITING_EXTERNAL_CUSTODIAN",
        "EXTERNAL_CUSTODY_ACCEPTED",
        "INVALIDATED"
      ]
    },
    "phase_required": {
      "const": "BEFORE_EXECUTION"
    },
    "custodian_identity": {
      "$ref": "#/$defs/nullableString"
    },
    "custodian_organization": {
      "$ref": "#/$defs/nullableString"
    },
    "signing_key_id": {
      "$ref": "#/$defs/nullableString"
    },
    "independence_statement": {
      "$ref": "#/$defs/nullableString"
    },
    "conflicts_of_interest_statement": {
      "$ref": "#/$defs/nullableString"
    },
    "no_prior_expectation_disclosure_attested": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "holdout_freshness_attested": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "disclosed_prior_manifest_binding": {
      "$ref": "#/$defs/artifactBinding"
    },
    "holdout_manifest_binding": {
      "$ref": "#/$defs/artifactBinding"
    },
    "required_case_roles": {
      "$ref": "#/$defs/caseRoleArray"
    },
    "covered_case_roles": {
      "$ref": "#/$defs/caseRoleArray"
    },
    "first_valid_unblinding_only_attested": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "no_selective_retry_or_deletion_attested": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "attested_utc": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "signature": {
      "$ref": "#/$defs/nullableString"
    },
    "external_attestation_artifact": {
      "$ref": "#/$defs/externalArtifactSlot"
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "qualificationId": {
      "type": "string",
      "pattern": "^jx\\.v5\\.solar_1pn\\.qualification\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "caseRoleArray": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GENERIC_3D",
          "ECCENTRIC",
          "LONG_ARC",
          "DOMAIN_INSIDE",
          "DOMAIN_BOUNDARY",
          "DOMAIN_OUTSIDE",
          "TRANSFORM_TWIN",
          "SIGNAL_SCALE",
          "EIH_LIMIT"
        ]
      }
    },
    "nullableString": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableTimestamp": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      }
    },
    "nullableRepositoryPath": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "nullablePositiveSize": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "nullableBoolean": {
      "if": {
        "const": null
      },
      "then": {
        "const": null
      },
      "else": {
        "type": "boolean"
      }
    },
    "externalArtifactSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "size_bytes",
        "sha256",
        "canonical_sha256",
        "signed_utc",
        "signature"
      ],
      "properties": {
        "status": {
          "enum": [
            "AWAITING_EXTERNAL_ATTESTATION_ARTIFACT",
            "EXTERNAL_ATTESTATION_ARTIFACT_BOUND",
            "INVALIDATED"
          ]
        },
        "path": {
          "$ref": "#/$defs/nullableRepositoryPath"
        },
        "size_bytes": {
          "$ref": "#/$defs/nullablePositiveSize"
        },
        "sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        },
        "canonical_sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        },
        "signed_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "signature": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "canonical_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nullableRepositoryPath"
        },
        "size_bytes": {
          "$ref": "#/$defs/nullablePositiveSize"
        },
        "sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        },
        "canonical_sha256": {
          "if": {
            "const": null
          },
          "then": {
            "const": null
          },
          "else": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
