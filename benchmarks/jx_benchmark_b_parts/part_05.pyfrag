                        [Body(b.body_id, b.name, b.mu, b.q.copy(), b.v.copy()) for b in solar] + [tracer],
                        notes=(
                            f"screening-only frozen ten-body injection; R_H={hill:.17e} AU; "
                            f"v_H={v_hill:.17e} AU/day; vinf/v_H={float(spec['v_infinity_hill']):g}"
                        ),
                    )
                )
    return result


def write_state(case: EncounterCase, path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", newline="", encoding="utf-8") as stream:
        writer = csv.writer(stream, lineterminator="\n")
        writer.writerow(("body_id", "body_name", "mu", "x", "y", "z", "vx", "vy", "vz"))
        for body in case.bodies:
            writer.writerow((
                body.body_id,
                body.name.replace(",", "_"),
                format(body.mu, ".17e"),
                format(float(body.q[0]), ".17e"),
                format(float(body.q[1]), ".17e"),
                format(float(body.q[2]), ".17e"),
                format(float(body.v[0]), ".17e"),
                format(float(body.v[1]), ".17e"),
                format(float(body.v[2]), ".17e"),
            ))


def result_state(result: dict[str, Any]) -> dict[int, tuple[np.ndarray, np.ndarray]]:
    return {
        int(row["body_id"]): (
            np.array([row["x"], row["y"], row["z"]], dtype=float),
            np.array([row["vx"], row["vy"], row["vz"]], dtype=float),
        )
        for row in result["final_state"]
    }


def run_native(executable: Path, mode: str, case: EncounterCase, state_path: Path,
               result_path: Path, *, steps: int | None = None,
               reference_profile: dict[str, Any] | None = None,
               timing_repeats: int = 3) -> dict[str, Any]:
    command = [
        str(executable),
        "--mode", mode,
        "--state", str(state_path),
        "--result", str(result_path),
        "--duration", format(case.duration, ".17e"),
        "--primary-id", str(case.primary_id),
        "--tracer-id", str(case.tracer_id),
    ]
    if steps is not None:
        command += [
            "--steps", str(steps),
            "--qscale", format(case.q_scale, ".17e"),
            "--vscale", format(case.v_scale, ".17e"),
            "--timing-repeats", str(timing_repeats),
        ]
    elif reference_profile is not None:
        command += [
            "--rtol", format(float(reference_profile["rtol"]), ".17e"),
            "--atol", format(float(reference_profile["atol"]), ".17e"),
            "--initial-step", format(case.tau_nominal * float(reference_profile["initial_step_tau_fraction"]), ".17e"),
            "--max-step", format(case.tau_nominal * float(reference_profile["max_step_tau_fraction"]), ".17e"),
        ]
    else:
        raise RuntimeError("native run missing schedule")
    completed = subprocess.run(command, check=False, text=True, capture_output=True)
    (result_path.with_suffix(result_path.suffix + ".log")).write_text(
        completed.stdout + completed.stderr, encoding="utf-8"
    )
    if completed.returncode != 0:
        raise RuntimeError(f"native {mode} failed for {case.case_id}: {completed.stderr.strip()}")
    return json.loads(result_path.read_text(encoding="utf-8"))


def state_arrays(case: EncounterCase) -> tuple[np.ndarray, np.ndarray, np.ndarray, list[int]]:
    return (
        np.array([body.q for body in case.bodies], dtype=float),
        np.array([body.v for body in case.bodies], dtype=float),
        np.array([body.mu for body in case.bodies], dtype=float),
        [body.body_id for body in case.bodies],
    )


def sampled_metrics(times: np.ndarray, positions: np.ndarray, velocities: np.ndarray,
                    primary_index: int, tracer_index: int) -> tuple[float, float, float]:
    relative_position = positions[:, tracer_index] - positions[:, primary_index]
    relative_velocity = velocities[:, tracer_index] - velocities[:, primary_index]
